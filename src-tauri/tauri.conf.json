{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Movex",
  "version": "0.1.0",
  "identifier": "com.movex.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Movex",
        "width": 1024,
        "height": 700,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "KVM por software — controle múltiplos computadores com um teclado e mouse",
    "longDescription": "Movex permite usar um único teclado e mouse para controlar múltiplos computadores pela rede local, com transferência de arquivos e sincronização de clipboard.",
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "digestAlgorithm": "sha256",
      "webviewInstallMode": {
        "type": "offlineInstaller"
      }
    }
  }
}
